# @BotFather dan olingan token (hech qachon git'ga commit qilmang!)
BOT_TOKEN=123456789:replace-me
# SQLite fayl yo'li (bot qayta ishga tushganda ham ma'lumotlar saqlanadi)
DB_PATH=data/navigator.db
# Adminlar Telegram ID lari, vergul bilan (savollar bazasini to'ldirish uchun)
ADMIN_IDS=
# --- Salyut effekti (ixtiyoriy) ---
# Animatsion sticker to'plami nomi (t.me/addstickers/<NOMI>). 🎆🎇🎉🥳🎊✨ emojili stickerlar tanlanadi.
CELEBRATION_STICKER_SET=
# Tayyor sticker file_id lari, vergul bilan
CELEBRATION_STICKERS=
# GIF/MP4 file_id lari yoki URL manzillari, vergul bilan
CELEBRATION_GIFS=
# Telegram "message effect" (🎉 to'liq ekranli effekt). O'chirish uchun 0 yozing.
CELEBRATION_EFFECT_ID=5046509860389126442
