<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ uchun zaxira qoidalari. Xarita fayllari (hajmi katta) zaxiralanmaydi. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <include domain="file" path="uznav/" />
        <exclude domain="file" path="maps/" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <include domain="file" path="uznav/" />
    </device-transfer>
</data-extraction-rules>
