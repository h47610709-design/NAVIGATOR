<?xml version="1.0" encoding="utf-8"?>
<!-- Sozlamalar ekrani: mavzu, ovoz, navigatsiya va xaritalar -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fon"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/fon_panel"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <ImageButton
            android:id="@+id/orqagaTugma"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/orqaga"
            android:src="@drawable/ic_orqaga"
            app:tint="@color/matn_asosiy" />

        <TextView
            style="@style/UzNav.Katta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/sozlamalar"
            android:textSize="20sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- ===== Mavzu ===== -->
            <com.google.android.material.card.MaterialCardView
                style="@style/UzNav.Panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        style="@style/UzNav.Katta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/mavzu"
                        android:textSize="17sp" />

                    <RadioGroup
                        android:id="@+id/mavzuGuruhi"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="vertical">

                        <RadioButton
                            android:id="@+id/mavzuTizim"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:text="@string/mavzu_tizim"
                            android:textColor="@color/matn_asosiy"
                            android:textSize="16sp" />

                        <RadioButton
                            android:id="@+id/mavzuYorug"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:text="@string/mavzu_yorug"
                            android:textColor="@color/matn_asosiy"
                            android:textSize="16sp" />

                        <RadioButton
                            android:id="@+id/mavzuTungi"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:text="@string/mavzu_tungi"
                            android:textColor="@color/matn_asosiy"
                            android:textSize="16sp" />
                    </RadioGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===== Ovoz ===== -->
            <com.google.android.material.card.MaterialCardView
                style="@style/UzNav.Panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/ovozKalit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/ovozli_yoriqnoma"
                        android:textColor="@color/matn_asosiy"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/ovozHolati"
                        style="@style/UzNav.Oddiy"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Ovoz holati tekshirilmoqda…"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/ovozSinovTugma"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:text="@string/ovozni_sinash"
                            android:textSize="13sp"
                            app:cornerRadius="14dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/ovozSozlamalariTugma"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:text="@string/ovoz_sozlamalari"
                            android:textSize="13sp"
                            app:cornerRadius="14dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===== Navigatsiya ===== -->
            <com.google.android.material.card.MaterialCardView
                style="@style/UzNav.Panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/tezlikOgohlantirishKalit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/tezlik_ogohlantirishi"
                        android:textColor="@color/matn_asosiy"
                        android:textSize="16sp" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/xaritaBurilishiKalit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/xarita_burilishi"
                        android:textColor="@color/matn_asosiy"
                        android:textSize="16sp" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/ekranYoniqKalit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/ekran_yoniq"
                        android:textColor="@color/matn_asosiy"
                        android:textSize="16sp" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/faqatWifiKalit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/faqat_wifi"
                        android:textColor="@color/matn_asosiy"
                        android:textSize="16sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===== Xaritalar ===== -->
            <com.google.android.material.card.MaterialCardView
                style="@style/UzNav.Panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:id="@+id/xaritaHolati"
                        style="@style/UzNav.Oddiy"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/xarita_yuklanmagan"
                        android:textSize="14sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/xaritalarTugma"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="10dp"
                        android:text="@string/xaritalarni_boshqarish"
                        app:cornerRadius="14dp"
                        app:icon="@drawable/ic_xarita"
                        app:iconGravity="textStart" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===== Ilova haqida ===== -->
            <TextView
                style="@style/UzNav.Katta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/ilova_haqida"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/ilovaHaqida"
                style="@style/UzNav.Oddiy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="16dp"
                android:lineSpacingExtra="3dp"
                android:text="UzNav"
                android:textSize="14sp" />
        </LinearLayout>
    </ScrollView>

</LinearLayout>
