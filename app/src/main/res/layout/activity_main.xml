<?xml version="1.0" encoding="utf-8"?>
<!--
  Asosiy navigatsiya ekrani.
  Tuzilishi: xarita (butun ekran) + ustidagi suzuvchi panellar.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/ildiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fon">

    <!-- Mapsforge offline xaritasi -->
    <org.mapsforge.map.android.view.MapView
        android:id="@+id/xarita"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Xarita fayli bo'lmasa ko'rsatiladigan matn -->
    <TextView
        android:id="@+id/xaritaYoqMatni"
        style="@style/UzNav.Katta"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="32dp"
        android:gravity="center"
        android:text="Xarita yuklanmagan.\nMenyu → Xaritalar bo'limidan O'zbekiston xaritasini yuklab oling."
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="visible" />

    <!-- ============ Yuqori qator: qidiruv paneli va menyu ============ -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/qidiruvPaneli"
        style="@style/UzNav.Panel"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="8dp"
        android:clickable="true"
        android:focusable="true"
        app:cardCornerRadius="26dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/menyuTugma">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@string/qayerga_boramiz"
                android:src="@drawable/ic_qidiruv"
                app:tint="@color/matn_ikkilamchi" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/qayerga_boramiz"
                android:textColor="@color/matn_asosiy"
                android:textSize="17sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/menyuTugma"
        style="@style/UzNav.Panel"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        android:clickable="true"
        android:focusable="true"
        app:cardCornerRadius="26dp"
        app:layout_constraintTop_toTopOf="@id/qidiruvPaneli"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:contentDescription="@string/menyu"
            android:src="@drawable/ic_menyu"
            app:tint="@color/matn_asosiy" />
    </com.google.android.material.card.MaterialCardView>

    <!-- GPS holati -->
    <TextView
        android:id="@+id/gpsHolati"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="8dp"
        android:background="@color/fon_panel"
        android:paddingStart="10dp"
        android:paddingTop="4dp"
        android:paddingEnd="10dp"
        android:paddingBottom="4dp"
        android:text="GPS qidirilmoqda…"
        android:textColor="@color/gps_qidirilmoqda"
        android:textSize="13sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/qidiruvPaneli"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- ============ O'ng tarafdagi boshqaruv tugmalari ============ -->
    <LinearLayout
        android:id="@+id/ongPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@id/boshlangichPanel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/menyuTugma"
        app:layout_constraintVertical_bias="1.0">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/kattalashtirishTugma"
            style="@style/UzNav.Panel"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginBottom="10dp"
            android:clickable="true"
            android:focusable="true"
            app:cardCornerRadius="24dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="@string/kattalashtirish"
                android:src="@drawable/ic_plus"
                app:tint="@color/matn_asosiy" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/kichiklashtirishTugma"
            style="@style/UzNav.Panel"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginBottom="10dp"
            android:clickable="true"
            android:focusable="true"
            app:cardCornerRadius="24dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="@string/kichiklashtirish"
                android:src="@drawable/ic_minus"
                app:tint="@color/matn_asosiy" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/joylashuvTugma"
            style="@style/UzNav.Panel"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/asosiy"
            app:cardCornerRadius="28dp">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:contentDescription="@string/mening_joylashuvim"
                android:src="@drawable/ic_joylashuv"
                app:tint="@color/oq" />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- ============ Tezlik ko'rsatkichi (chap past) ============ -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/tezlikPanel"
        style="@style/UzNav.Panel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        app:cardCornerRadius="16dp"
        app:layout_constraintBottom_toTopOf="@id/boshlangichPanel"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="10dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tezlikQiymati"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="@color/matn_asosiy"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tezlik_km_soat"
                    android:textColor="@color/matn_ikkilamchi"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Tezlik cheklovi belgisi (ma'lumot bo'lsa ko'rinadi) -->
            <TextView
                android:id="@+id/tezlikCheklovi"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_tezlik_cheklovi"
                android:gravity="center"
                android:text="70"
                android:textColor="@color/qora"
                android:textSize="17sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ============ Boshlang'ich pastki panel ============ -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/boshlangichPanel"
        style="@style/UzNav.Panel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/qayergaTugma"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="@string/qayerga"
                android:textSize="17sp"
                app:cornerRadius="14dp"
                app:icon="@drawable/ic_qidiruv"
                app:iconGravity="textStart" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/uyTugma"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="@string/uy"
                    app:cornerRadius="14dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/ishTugma"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="@string/ish"
                    app:cornerRadius="14dp" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ============ Marshrut hisoblash paneli ============ -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/hisoblashPaneli"
        style="@style/UzNav.Panel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/hisoblashMatni"
                style="@style/UzNav.Katta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/marshrut_hisoblanmoqda"
                android:textSize="18sp" />

            <ProgressBar
                android:id="@+id/hisoblashDarajasi"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:max="100"
                android:progress="30" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/hisobBekorTugma"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="4dp"
                android:text="@string/bekor_qilish" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ============ Marshrut varianti paneli ============ -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/marshrutPaneli"
        style="@style/UzNav.Panel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/manzilNomi"
                style="@style/UzNav.Katta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="Tanlangan manzil"
                android:textSize="19sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/variantTez"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:checkable="true"
                    android:lines="2"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text="@string/eng_tez"
                    android:textSize="12sp"
                    app:cornerRadius="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/variantQisqa"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:checkable="true"
                    android:lines="2"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text="@string/eng_qisqa"
                    android:textSize="12sp"
                    app:cornerRadius="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/variantPulliksiz"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:checkable="true"
                    android:lines="2"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text="@string/pullik_yolsiz"
                    android:textSize="12sp"
                    app:cornerRadius="12dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/marshrutXulosa"
                style="@style/UzNav.Oddiy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text=""
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/marshrutBekorTugma"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="@string/bekor_qilish"
                    app:cornerRadius="14dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/marshrutBoshlashTugma"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1.4"
                    android:text="@string/marshrutni_boshlash"
                    app:cornerRadius="14dp"
                    app:icon="@drawable/ic_navigatsiya"
                    app:iconGravity="textStart" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ============ Navigatsiya: keyingi burilish paneli (yuqorida) ============ -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/burilishPaneli"
        style="@style/UzNav.Panel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/asosiy"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <ImageView
                android:id="@+id/burilishBelgisi"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="Keyingi burilish"
                android:src="@drawable/ic_togriga"
                app:tint="@color/oq" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/burilishMasofasi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="300 m"
                    android:textColor="@color/oq"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/burilishMatni"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="O'ngga buriling"
                    android:textColor="@color/oq"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/burilishYoli"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Amir Temur ko'chasi"
                    android:textColor="#D8E6FF"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Qayta hisoblash ogohlantirishi -->
    <TextView
        android:id="@+id/qaytaHisoblashMatni"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@color/ogohlantirish"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp"
        android:text="@string/qayta_marshrut_hisoblanmoqda"
        android:textColor="@color/oq"
        android:textSize="14sp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/burilishPaneli"
        tools:visibility="visible" />

    <!-- ============ Navigatsiya: pastki ma'lumot paneli ============ -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/navigatsiyaPaneli"
        style="@style/UzNav.Panel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/qolganMasofa"
                    style="@style/UzNav.Katta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="12,4 km"
                    android:textSize="20sp" />

                <TextView
                    style="@style/UzNav.Oddiy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/qolgan_masofa"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/qolganVaqt"
                    style="@style/UzNav.Katta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="18 daq"
                    android:textSize="20sp" />

                <TextView
                    style="@style/UzNav.Oddiy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/qolgan_vaqt"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/yetibBorishVaqti"
                    style="@style/UzNav.Katta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="14:35"
                    android:textSize="20sp" />

                <TextView
                    style="@style/UzNav.Oddiy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/yetib_borish"
                    android:textSize="12sp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/navigatsiyaToxtatishTugma"
                style="@style/Widget.Material3.Button.IconButton.Filled"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/marshrutni_toxtatish"
                app:backgroundTint="@color/gps_yoq"
                app:icon="@drawable/ic_toxtatish"
                app:iconTint="@color/oq" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
