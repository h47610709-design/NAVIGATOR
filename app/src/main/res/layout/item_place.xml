<?xml version="1.0" encoding="utf-8"?>
<!-- Qidiruv natijasi / sevimli joy / tarix elementi -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="10dp"
    android:paddingEnd="16dp"
    android:paddingBottom="10dp">

    <ImageView
        android:id="@+id/joyBelgisi"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_obyekt"
        app:tint="@color/asosiy" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/joyNomi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Amir Temur ko'chasi 108"
            android:textColor="@color/matn_asosiy"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/joyManzili"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="Toshkent shahri"
            android:textColor="@color/matn_ikkilamchi"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/joyMasofasi"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:text="2,4 km"
        android:textColor="@color/matn_ikkilamchi"
        android:textSize="13sp"
        tools:ignore="RelativeOverlap" />

</LinearLayout>
